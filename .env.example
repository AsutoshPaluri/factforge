# =========================================================
# factforge — environment template
# Copy to .env (or backend/.env) and fill in your values.
# All services here have free tiers; none require a credit card.
#
# Format rules:
#   - No quotes around values
#   - No inline comments after `=` (pydantic-settings parses the WHOLE rhs)
#   - Comments live on their own lines, starting with #
# =========================================================


# --- Required ---

# Gemini API
# https://aistudio.google.com/app/apikey
# Free tier: 1M tokens/day, 15 RPM, multimodal (text + vision)
# Used for: vision-mode decomposition (image inputs) only when GROQ_API_KEY is set
GEMINI_API_KEY=

# Groq API — primary LLM for text decomposition + summarization
# https://console.groq.com
# Free tier: ~30 RPM, ~14k requests/day for Llama 3.3 70B
# Used for: text-only claim decomposition + summary generation
GROQ_API_KEY=

# Supabase — Project Settings -> API
# https://supabase.com
# Free tier: 500MB Postgres + pgvector, 1GB storage, unlimited auth users
SUPABASE_URL=
# "Publishable" key (sb_publishable_...) — safe to expose in frontend
SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_...) — SERVER ONLY, never commit
SUPABASE_SECRET_KEY=


# --- Optional but recommended ---

# Langfuse cloud — agent observability + tracing
# Free tier: 50k observations/month
# Region: use https://us.cloud.langfuse.com (US) or https://cloud.langfuse.com (EU)
# Must match the region where you created the project.
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Sentry — error tracking
# https://sentry.io
# Free tier: 5k events/month
SENTRY_DSN=

# Upstash Redis — cost tracker + rate limiting
# https://upstash.com
# Free tier: 10k commands/day
# Leave blank to use in-memory fallback (resets on restart, fine for local dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Modal — GPU-hosted NLI inference (huge speedup vs CPU)
# https://modal.com  — free tier: $1/month compute credits, no credit card
# Deploy with: modal deploy infra/factforge_nli_modal.py
# When both vars are set, the NLI client calls Modal first and falls
# back to the local CPU model on any failure. Leave blank to use local only.
MODAL_NLI_URL=
MODAL_NLI_API_KEY=


# --- App config (defaults are fine for local dev) ---

# Daily budget caps (free-tier ceilings; tighten in prod if needed)
# 800000 = 80% of Gemini's 1M-token-per-day free tier
DAILY_GEMINI_TOKENS_CAP=800000
# Soft cap to avoid DDG rate-limit bans
DAILY_DDG_SEARCHES_CAP=1000

# Rate limits: claims per day, per IP (anon) and per user_id (signed-in)
ANON_CLAIMS_PER_DAY=2
USER_CLAIMS_PER_DAY=10

# NLI model (downloaded from HuggingFace on first run, cached locally)
NLI_MODEL_NAME=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli
# Inference device: cpu | mps (Apple Silicon) | cuda
NLI_DEVICE=cpu

# Gemini model
GEMINI_MODEL=gemini-2.5-flash

# CORS: frontend origin allowed to call the API
FRONTEND_URL=http://localhost:3000

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
